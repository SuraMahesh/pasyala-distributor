# PostgreSQL connection. Leave empty to use the embedded database in backend/.data (development only).
DATABASE_URL=postgres://pjd:pjd@localhost:5432/pjd_erp

PORT=4000
# Load the 53 products + 5 Pasyale invoices when the database is empty
SEED_ON_EMPTY=true
# Browser origins allowed to call the API from another site, comma-separated. Leave unset when the API serves the
# web app itself (production default) or in dev (Vite proxies /api) — then cross-origin calls are refused.
# CORS_ORIGIN=https://erp.example.com

# Login password for the whole system (8+ characters). Leave empty only on your own laptop.
# Required on Vercel / any public server. Changing it logs everyone out.
APP_PASSWORD=
# Login tokens are signed with a random secret created on first start and kept in the database.
# Optional: provide your own instead (changing it logs everyone out)
# AUTH_SECRET=
# Behind Nginx/Caddy set TRUST_PROXY=1 so the login rate limiter sees real client IPs (Vercel is handled automatically)
# TRUST_PROXY=1

# AI features (invoice scanning + the Assistant page) need ONE of:
#   (a) an Anthropic key from console.anthropic.com (paid; best results — Claude), or
#   (b) an OpenRouter key from openrouter.ai/settings/keys with ANTHROPIC_BASE_URL set (free models available).
# Leave ANTHROPIC_API_KEY empty to turn both features off — invoices can still be typed in.
ANTHROPIC_API_KEY=
# (b) only: send requests to OpenRouter's Anthropic-compatible endpoint instead of api.anthropic.com
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# Which model reads invoice photos / PDFs. Default: claude-sonnet-5-5 on Anthropic, openrouter/free on OpenRouter.
# On OpenRouter pick a FREE model that supports tools AND images, e.g. nvidia/nemotron-3.5-super-vl:free
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Invoice photos. On Vercel: Storage → Create → Blob (Private) → connect to this project; that adds
# BLOB_READ_WRITE_TOKEN automatically. Without it (on your own computer) photos are kept in UPLOAD_DIR.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
# UPLOAD_DIR=./.data/uploads

# Product Manager Assistant (Assistant page). Uses the same ANTHROPIC_API_KEY as scanning.
# Which model answers. Default: claude-opus-5-5 on Anthropic, openrouter/free on OpenRouter.
# On OpenRouter pick a FREE model that supports tools, e.g. nvidia/nemotron-3.5-super-vl:free
# (free models: ~20 requests/minute and a daily cap; one question uses several requests)
# ASSISTANT_MODEL=claude-opus-5-5
# Second secret, known only to the owner (6+ characters): required to approve or reject stock-count requests from the assistant.
OWNER_PIN=
