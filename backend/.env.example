# PostgreSQL connection. Leave empty to use the embedded database in backend/.data (development only).
DATABASE_URL=postgres://pjd:pjd@localhost:5432/pjd_erp

PORT=4000
# Load the 53 products + 5 Pasyale invoices when the database is empty
SEED_ON_EMPTY=true
# Allowed browser origin for the API (dev frontend runs on 5173 and uses a proxy, so usually not needed)
# CORS_ORIGIN=http://localhost:5173

# Login password for the whole system. Leave empty only on your own laptop.
# Required on Vercel / any public server.
APP_PASSWORD=
# Optional: separate signing secret (changing it logs everyone out)
# AUTH_SECRET=

# Scan invoice photos / PDFs (Sales → New, Purchases → New). Get a key at console.anthropic.com.
# Leave empty to turn scanning off — invoices can still be typed in.
ANTHROPIC_API_KEY=
# Optional: which Claude model reads the invoices
# ANTHROPIC_MODEL=claude-sonnet-5-5
